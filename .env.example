# Copy to .env for local development. NEVER commit the real .env —
# it is gitignored and the pre-commit hook blocks it.
#
# In production nothing here is set by hand: Cloud Run injects PORT and the
# service identity, and WEBHOOK_SIGNING_SECRET comes from Secret Manager
# mounted as an env var. A value committed to this public repo is compromised
# on push.

# --- Required -----------------------------------------------------------------
# Startup fails fast if any of these three is missing.
GCP_PROJECT=your-project-id
PUBSUB_TOPIC=webhook-events

# The static token Aptly sends in its x-signingkey header. Verified with a
# constant-time comparison. An empty value must fail closed — never accept
# unauthenticated requests.
WEBHOOK_SIGNING_SECRET=

# --- Optional (defaults shown) --------------------------------------------------
# Header carrying the shared secret. Aptly sends `x-signingkey`; HTTP header
# names are case-insensitive so the casing here is cosmetic.
WEBHOOK_SIGNING_KEY_HEADER=X-SigningKey

# Reject bodies larger than this before publishing. Must stay under the
# Pub/Sub 10MB message cap.
MAX_BODY_BYTES=1048576

# Value published as the `source` message attribute.
WEBHOOK_SOURCE=aptly

# --- Service -------------------------------------------------------------------
# Cloud Run sets PORT itself; this is the local default.
PORT=8080
LOG_LEVEL=INFO

# --- Local only ------------------------------------------------------------------
# On Cloud Run the service account is ambient — leave this unset there.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local-key.json
