# Copy to .env for local development. NEVER commit the real .env —
# it is gitignored and the pre-commit hook blocks it.
#
# In production nothing here is set by hand: Cloud Run injects GCP_PROJECT and
# the service identity, and any real secret comes from Secret Manager mounted
# as an env var. A value committed to this public repo is compromised on push.

# --- GCP ---------------------------------------------------------------------
GCP_PROJECT=your-project-id
PUBSUB_TOPIC=webhook-events

# Local only. On Cloud Run the service account is ambient — leave this unset.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/local-key.json

# --- Webhook verification ----------------------------------------------------
# Shared secret used to verify inbound signatures. Source from Secret Manager
# in every deployed environment.
WEBHOOK_SIGNING_SECRET=

# --- Service -----------------------------------------------------------------
# Cloud Run sets PORT itself; this is the local default.
PORT=8080
LOG_LEVEL=INFO
