#!/usr/bin/env bash
#
# pre-commit — block likely secrets from reaching a PUBLIC repo.
#
# A credential pushed to a public repo is compromised the moment it lands:
# GitHub's event firehose is scraped continuously, and forks plus the commit
# cache survive a force-push. Rotate first, scrub second — never the reverse.
#
# Enabled via `git config core.hooksPath .githooks` (see README).
# Bypass with `git commit --no-verify` only when you are certain a hit is a
# false positive, and say so in the commit message.

set -uo pipefail

fail=0
note() { echo "  ✖ $1" >&2; fail=1; }

# --- 1. Whole files that should never be committed ---------------------------
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$(basename "$f")" in
    .env|.env.*)
      [ "$(basename "$f")" = ".env.example" ] && continue
      note "staged env file: $f" ;;
    *credentials*.json|service-account*.json|*-key.json|id_rsa|id_ed25519)
      note "staged credential file: $f" ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

# --- 2. Secret-shaped content in the staged diff -----------------------------
# Only added lines (^+) are scanned, so pre-existing text never re-triggers.
added="$(git diff --cached --unified=0 --diff-filter=ACM | grep '^+' | grep -v '^+++' || true)"

if [ -n "$added" ]; then
  # -e is REQUIRED: several patterns begin with "-" (e.g. the -----BEGIN
  # PRIVATE KEY----- block), which grep would otherwise parse as options.
  scan() { echo "$added" | grep -qEi -e "$1" && note "$2"; }

  scan '-----BEGIN [A-Z ]*PRIVATE KEY-----'      "private key block"
  scan '"type"[[:space:]]*:[[:space:]]*"service_account"' "GCP service-account JSON"
  scan '\bAKIA[0-9A-Z]{16}\b'                    "AWS access key id"
  scan '\bAIza[0-9A-Za-z_-]{35}\b'               "Google API key"
  scan '\bgh[pousr]_[0-9A-Za-z]{36,}'            "GitHub token"
  scan '\bxox[abprs]-[0-9A-Za-z-]{10,}'          "Slack token"
  scan '\bsk-[0-9A-Za-z]{32,}'                   "OpenAI-style API key"
  scan '\bsk-ant-[0-9A-Za-z_-]{20,}'             "Anthropic API key"

  # Generic assignment of a long literal to a secret-ish name. Filtered out:
  #   1. documented placeholders (.env.example, docs)
  #   2. env-var indirection — the code READS a secret, it does not contain one
  #   3. REFERENCES to a secret store: --set-secrets NAME=secret-name:latest,
  #      k8s secretKeyRef, GitHub Actions secrets.X. A secret's *name* is not
  #      its value, and deploy docs are full of them.
  #   4. prose that merely NAMES the pattern. The right-hand side must look like
  #      a real credential token — a run of 12+ token characters — not the next
  #      word of a sentence. Without this, docs ABOUT secret scanning trip the
  #      secret scanner (e.g. a list of `password =`, `api_key =` patterns).
  #   5. assignment from a NAME rather than a literal — the right-hand side is a
  #      dotted attribute or a snake_case identifier, so the code points at a
  #      credential instead of containing one. Indirection is the correct pattern
  #      and flagging it punishes the fix. A bare literal with neither a dot nor
  #      an underscore is still caught.
  # Escape hatch: append   # pragma: allow-secret   to a line to skip it.
  echo "$added" \
    | grep -Evi 'pragma:[[:space:]]*allow-secret' \
    | grep -Ei '(api[_-]?key|secret|password|passwd|token|private[_-]?key)[[:space:]]*[:=][[:space:]]*[^[:alnum:]]{0,2}[A-Za-z0-9_+/=.-]{12,}' \
    | grep -Evi '(example|placeholder|changeme|your[_-]|xxx+|\*\*\*|<[a-z_]+>|\$\{?[A-Z_]+\}?)' \
    | grep -Evi '(os\.environ|getenv|process\.env|secret(manager|client))' \
    | grep -Evi '(--set-secrets|secretkeyref|value_?from|secrets\.[a-z_]|\$\{\{|:latest([[:space:]]|$)|:[0-9]+$)' \
    | grep -Evi '_key[[:space:]]*[:=][[:space:]]*"[a-z_]+"' \
    | grep -Evi '[:=][[:space:]]*(([a-z_][a-z0-9_]*\.)+[a-z_][a-z0-9_]*|[a-z][a-z0-9]*(_[a-z0-9]+)+)[[:space:]]*[,)]?[[:space:]]*$' \
    | grep -q . && note "hardcoded credential assignment"
fi

if [ "$fail" -ne 0 ]; then
  cat >&2 <<'MSG'

COMMIT BLOCKED — this repo is public.

Move the value into an environment variable or Secret Manager, document the
name in .env.example, and re-stage. If the value is genuinely not a secret,
re-run with:  git commit --no-verify

MSG
  exit 1
fi

exit 0
